@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@inherits PanelComponent

@{
	var health = Health;
	var armor = Armor;
	var stamina = Stamina;
	var lifeState = LifeState;
	var isLocalHud = IsLocalHud;

	float startingHealth = MathF.Max( 1f, health?.StartingHardMaxHealth ?? 100f );
	float hardPercent = Percent( health?.HardMaxHealth ?? 0f, startingHealth );
	float softPercent = Percent( health?.SoftMaxHealth ?? 0f, startingHealth );
	float currentPercent = Percent( health?.CurrentHealth ?? 0f, startingHealth );
	float armorPercent = Percent( armor?.CurrentArmor ?? 0f, armor?.MaxArmor ?? 0f );
	float staminaPercent = Percent( stamina?.CurrentStamina ?? 0f, stamina?.MaxStamina ?? 0f );

	bool isDowned = health?.IsDowned ?? false;
	bool isDead = health?.IsDead ?? false;
	bool isExhausted = stamina?.IsExhausted ?? false;
	bool showStamina = stamina is not null && stamina.CurrentStamina < stamina.MaxStamina;
    // Meme palette/limites que HEALTH, mais sur le pourcentage d'endurance restante.
    string staminaState = isExhausted || staminaPercent <= 30f ? "danger"
        : staminaPercent <= 65f ? "medium" : "healthy";
	// Comportement initial : l'armure n'apparait que lorsqu'elle est presente.
	bool showArmor = armor is not null && armor.CurrentArmor > 0f;
	// La soft health (plafond souple, borne par la vie courante) pilote l'ECG et la couleur.
	float softLife = MathF.Min( health?.CurrentHealth ?? 0f, health?.SoftMaxHealth ?? 0f );
	float softLifeRatio = Percent( softLife, startingHealth ) / 100f;
	string healthState = softLifeRatio <= 0.30f ? "danger" : softLifeRatio <= 0.65f ? "medium" : "healthy";
	bool canSpectate = lifeState?.CanSpectate ?? false;
	string spectatedPlayerName = lifeState?.SpectatedPlayerName;
}

<root class="@RootClass palette">
	@if ( !isLocalHud )
	{
	}
	else if ( health is null )
	{
		<div class="missing-player">
			<label>#vb.hud.initializing</label>
		</div>
	}
	else
	{
		<div class="helmet-layer" @ref="HelmetLayer">
			<div class="vitals-block">
				<div class="stamina-slot @(showStamina ? "visible" : "")">
					@if ( showStamina )
					{
						<div class="readout stamina-readout @staminaState @(isExhausted ? "exhausted" : "")">
							<div class="readout-header">
								<label class="readout-icon">»</label>
								<label class="readout-title">#vb.hud.stamina</label>
								<label class="readout-value">@Whole( stamina.CurrentStamina )</label>
							</div>
							<div class="resource-track">
								<div class="stamina-fill" style="width: @(staminaPercent)%;"></div>
							</div>
							@if ( isExhausted )
							{
								<label class="resource-warning">#vb.hud.exhausted</label>
							}
						</div>
					}
				</div>

				<div class="bottom-row">
					<div class="readout health-readout @healthState">
						<div class="readout-header">
							<label class="readout-icon">+</label>
							<label class="readout-title">HEALTH</label>
						</div>
						<div class="readout-main">
							<label class="readout-value">@Whole( health.CurrentHealth )</label>
							<div class="pulse-trace">
								@if ( isDead )
								{
									<div class="ecg-flatline"></div>
								}
								else
								{
									@* Chaque segment relie DEUX mesures temporelles du signal.
									   La trace n'est pas une image ni une animation CSS repetee. *@
									@for ( int i = 0; i < EcgSampleCount - 1; i++ )
									{
										<div class="ecg-segment" style="@(EcgSegmentStyle( i ))"></div>
									}
								}
							</div>
						</div>
						<div class="health-track">
							<div class="hard-max" style="width: @(hardPercent)%;"></div>
							<div class="soft-max" style="width: @(softPercent)%;"></div>
							<div class="current-health" style="width: @(currentPercent)%;"></div>
						</div>
					</div>

					@if ( showArmor )
					{
						<div class="readout armor-readout">
							<div class="readout-header">
								<label class="readout-icon">ϟ</label>
								<label class="readout-title">#vb.hud.armor</label>
							</div>
							<div class="readout-main">
								<label class="readout-value">@Whole( armor.CurrentArmor )</label>
								<div class="armor-ticks">
									@for ( int i = 0; i < 10; i++ )
									{
										<div class="scan-tick"></div>
									}
								</div>
							</div>
							<div class="resource-track">
								<div class="armor-fill" style="width: @(armorPercent)%;"></div>
							</div>
						</div>
					}
				</div>
			</div>

			<VBAmmoHud Player=@(LocalPlayer) IsSuppressed=@(isDowned || isDead) />
			<VBWeaponSelectorHud Player=@(LocalPlayer) IsSuppressed=@(isDowned || isDead) />
			<VBTraversalHud Player=@(LocalPlayer) IsSuppressed=@(isDowned || isDead) />
			<VBVehicleHud Player=@(LocalPlayer) />
		</div>

		@if ( isDowned )
		{
			<div class="state-overlay downed-overlay">
				<label class="state-title">#vb.hud.critical</label>
				<label class="state-detail">#vb.hud.stabilization_required</label>
				<div class="bleedout-track">
					<div class="bleedout-fill" style="width: @(hardPercent)%;"></div>
				</div>
				<label class="state-value">@Whole( health.HardMaxHealth )</label>
			</div>
		}

		@if ( isDead )
		{
			<div class="state-overlay dead-overlay death-menu">
				<label class="state-title">#vb.hud.signal_lost</label>
				<label class="state-detail">#vb.hud.subject_deceased</label>

				<div class="death-reason">
					<label class="death-reason-title">#vb.hud.cause_of_death</label>
					<label class="death-reason-value">@DeathReason</label>
				</div>

				@if ( !string.IsNullOrWhiteSpace( spectatedPlayerName ) )
				{
					<label class="spectating-label">@Phrase( "vb.hud.spectating", "Name", spectatedPlayerName )</label>
				}
				else if ( !canSpectate )
				{
					<label class="spectating-label unavailable">#vb.hud.no_spectate_targets</label>
				}

				<div class="death-actions">
					<Button class="death-button spectate-button"
						Text="#vb.hud.spectate"
						Icon="visibility"
						Disabled=@(!canSpectate)
						onclick=@SpectateNext />
					<Button class="death-button menu-button"
						Text="#vb.hud.return_to_menu"
						Icon="logout"
						onclick=@ReturnToMenu />
				</div>
			</div>
		}

		<VBInteractionHud Player=@(LocalPlayer) IsSuppressed=@(isDowned || isDead) />
		<VBCrosshairHud Player=@(LocalPlayer) IsSuppressed=@(isDowned || isDead) />
	}
</root>

@code
{
	[Property, Group( "Appearance" ), Title( "HUD Colors" ), InlineEditor]
	public VBHudPalette Colors { get; set; } = new();
	private readonly VBHudPaletteStyles _paletteStyles = new();

	[Property, Group( "Visor Motion" )]
	public bool EnableHelmetMotion { get; set; } = true;

	[Property, Group( "Visor Motion" ), Range( 0f, 1f )]
	public float HelmetMotionStrength { get; set; } = 0.65f;

	private Panel HelmetLayer { get; set; }
	private GameObject _helmetPlayer;
	private VBVehicleSeat _helmetSeat;
	private Rotation _helmetLook;
	private Vector3 _helmetVelocity;
	private Vector2 _helmetOffset;
	private float _helmetRoll;
	private bool _helmetInitialized;

	private void UpdateHelmetMotion()
	{
		if ( HelmetLayer is null ) return;
		var player = LocalPlayer;
		var controller = player.IsValid() ? player.GetComponent<PlayerController>() : null;
		var health = Health;
		if ( !EnableHelmetMotion || !controller.IsValid() || controller.ThirdPerson
			|| health is null || health.IsDead || health.IsDowned )
		{
			_helmetInitialized = false;
			_helmetOffset = Vector2.Zero;
			_helmetRoll = 0f;
			HelmetLayer.Style.Set( "transform", "translate(0px, 0px) rotate(0deg)" );
			return;
		}

		var seat = player.GetComponent<VBVehiclePlayerDriver>()?.ActiveSeat;
		var vehicle = seat?.Vehicle;
		var velocity = vehicle.IsValid() ? vehicle.LinearVelocity : controller.Velocity;
		var look = controller.EyeTransform.Rotation;
		float dt = Math.Clamp( Time.Delta, 0.001f, 0.1f );
		if ( !_helmetInitialized || _helmetPlayer != player || _helmetSeat != seat || Time.Delta > 0.15f )
		{
			_helmetInitialized = true;
			_helmetPlayer = player;
			_helmetSeat = seat;
			_helmetLook = look;
			_helmetVelocity = velocity;
			_helmetOffset = Vector2.Zero;
			_helmetRoll = 0f;
		}

		_helmetLook = Rotation.Slerp( _helmetLook, look, 1f - MathF.Exp( -12f * dt ) );
		var lag = Rotation.Difference( look, _helmetLook );
		var acceleration = look.Inverse * ((velocity - _helmetVelocity) / dt).ClampLength( 600f );
		_helmetVelocity = velocity;
		var target = new Vector2( Math.Clamp( lag.Yaw() * 0.2f, -2.5f, 2.5f ),
			Math.Clamp( -lag.Pitch() * 0.2f, -2f, 2f ) );
		target += new Vector2( acceleration.y, acceleration.z ) * 0.0015f;
		var bob = player.GetComponent<VBFirstPersonHeadbob>();
		if ( !seat.IsValid() && bob.IsValid() )
		{
			float amount = bob.MovementStrength * (1f + bob.RunAmount * 0.4f);
			target += new Vector2( MathF.Sin( bob.MovementPhase ) * 0.85f,
				MathF.Cos( bob.MovementPhase * 2f ) * 0.55f ) * amount;
		}
		var weapon = player.GetComponent<BaseInventoryComponent>()?.ActiveItem as VBCombatWeapon;
		float strength = Math.Clamp( HelmetMotionStrength, 0f, 1f ) * (1f - (weapon?.AimAmount ?? 0f) * 0.7f);
		target *= strength;
		float blend = 1f - MathF.Exp( -10f * dt );
		_helmetOffset += (target - _helmetOffset) * blend;
		_helmetRoll += (Math.Clamp( -target.x * 0.055f, -0.18f, 0.18f ) - _helmetRoll) * blend;
		// Only the visor layer moves. World markers, aim and death controls keep their coordinates.
		HelmetLayer.Style.Set( "transform", $"translate({CssNumber( _helmetOffset.x )}px, {CssNumber( _helmetOffset.y )}px) rotate({CssNumber( _helmetRoll )}deg)" );
	}

	[Property]
	public GameObject Player { get; set; }

	private bool IsLocalHud => Player.IsValid() ? !Player.IsProxy : !IsProxy;

	private GameObject LocalPlayer
	{
		get
		{
			if ( !IsLocalHud )
				return null;

			if ( Player.IsValid() )
				return Player;

			return Scene?
				.GetAll<VBHealthComponent>()
				.FirstOrDefault( component => !component.IsProxy )
				?.GameObject;
		}
	}

	private VBHealthComponent Health => LocalPlayer?.Components.Get<VBHealthComponent>();
	private VBArmorComponent Armor => LocalPlayer?.Components.Get<VBArmorComponent>();
	private VBStaminaComponent Stamina => LocalPlayer?.Components.Get<VBStaminaComponent>();
	private VBPlayerLifeStateController LifeState => LocalPlayer?.Components.Get<VBPlayerLifeStateController>();

	private string DeathReason
	{
		get
		{
			var health = Health;
			if ( health is null )
				return Phrase( "vb.hud.death_unknown" );

			if ( !string.IsNullOrWhiteSpace( health.DownedInstigatorName ) )
				return Phrase( "vb.hud.death_by_player", "Name", health.DownedInstigatorName );

			var token = string.IsNullOrWhiteSpace( health.DownedReasonToken )
				? "vb.hud.death_unknown"
				: health.DownedReasonToken.TrimStart( '#' );

			return Phrase( token );
		}
	}

	private string RootClass
	{
		get
		{
			if ( !IsLocalHud )
				return "remote";

			if ( Health?.IsDead ?? false )
				return "dead";

			if ( Health?.IsDowned ?? false )
				return "downed";

			return string.Empty;
		}
	}

	// Un segment par intervalle de 2px : 50 segments sur 100px.
	// 25 mesures par seconde, pour eviter de reconstruire le HUD a chaque frame.
	private const int EcgSampleCount = 51;
	private const float EcgSampleInterval = 0.04f;
	private const float EcgPointSpacing = 2f;
	private readonly float[] _ecgSamples = new float[EcgSampleCount];
	private float _ecgAccumulator;
	private float _ecgPhase;
	private float _ecgTime;
	private int _ecgBeatIndex;
	private int _ecgRevision;
	private Guid _ecgPlayerId;

	protected override void OnUpdate()
	{
		base.OnUpdate();
		UpdateHelmetMotion();
		if ( !IsLocalHud )
			return;
		_paletteStyles.Apply( Panel, Colors, Id );

		var health = Health;
		if ( health is null || health.IsDead )
			return;

		// En cas de changement de personnage, ne pas afficher les battements precedents.
		var playerId = LocalPlayer?.Id ?? Guid.Empty;
		if ( playerId != _ecgPlayerId )
		{
			_ecgPlayerId = playerId;
			Array.Clear( _ecgSamples, 0, _ecgSamples.Length );
			_ecgAccumulator = 0f;
			_ecgPhase = 0f;
			_ecgBeatIndex = 0;
		}

		_ecgAccumulator += Math.Clamp( Time.Delta, 0f, 0.1f );
		int generated = 0;
		while ( _ecgAccumulator >= EcgSampleInterval && generated < 4 )
		{
			_ecgAccumulator -= EcgSampleInterval;
			_ecgTime += EcgSampleInterval;

			float initialHard = MathF.Max( 1f, health.StartingHardMaxHealth );
			float hardRatio = Math.Clamp( health.HardMaxHealth / initialHard, 0f, 1f );
			float softLife = MathF.Min( health.SoftMaxHealth, health.CurrentHealth );
			float softRatio = Math.Clamp( softLife / initialHard, 0f, 1f );
			float integrity = MathF.Min( softRatio, hardRatio );
			float severity = 1f - integrity;

			// Sur-echantillonner la periode de 40 ms, sinon le pic R
			// (tres bref) peut etre manque entre deux rafraichissements.
			// On retient le point de plus grande amplitude du sous-intervalle.
			const int subSteps = 8;
			float subDelta = EcgSampleInterval / subSteps;
			float selectedSample = 0f;
			for ( int sub = 0; sub < subSteps; sub++ )
			{
				// 64 BPM au maximum, jusqu'a ~166 BPM en etat critique.
				// A bas HP, l'intervalle varie legerement a chaque beat.
				float bpm = 64f + 102f * MathF.Pow( severity, 1.35f );
				float variability = severity * 0.05f * MathF.Sin( _ecgBeatIndex * 1.83f );
				_ecgPhase += subDelta * bpm * (1f + variability) / 60f;
				if ( _ecgPhase >= 1f )
				{
					_ecgPhase -= MathF.Floor( _ecgPhase );
					_ecgBeatIndex++;
				}

				float beatStrength = 1f - severity * 0.07f
					+ severity * 0.04f * MathF.Sin( _ecgBeatIndex * 1.37f );
				float candidate = EcgWave( _ecgPhase ) * beatStrength;
				if ( MathF.Abs( candidate ) > MathF.Abs( selectedSample ) )
					selectedSample = candidate;
			}

			// Derive de la ligne de base tres discrete.
			float signal = selectedSample;
			signal += 0.009f * MathF.Sin( _ecgTime * 7.1f );
			signal += 0.008f * MathF.Sin( _ecgTime * 2.3f );

			Array.Copy( _ecgSamples, 1, _ecgSamples, 0, EcgSampleCount - 1 );
			_ecgSamples[EcgSampleCount - 1] = signal;
			_ecgRevision++;
			generated++;
		}

		// Apres une grosse chute de framerate on elimine le retard
		// au lieu de faire des centaines de regenerations en rafale.
		if ( _ecgAccumulator > EcgSampleInterval * 4f )
			_ecgAccumulator = 0f;
	}

	private static float EcgWave( float phase )
	{
		// Complexe P–QRS–T parametrique. Les impulsions sont ECHANTILLONNEES
		// en temps reel ; leur intervalle depend de la vie soft/hard.
		return 0.13f * Peak( phase, 0.15f, 0.045f )  // P
			- 0.16f * Peak( phase, 0.285f, 0.014f ) // Q
			+ 1.00f * Peak( phase, 0.315f, 0.015f ) // R
			- 0.27f * Peak( phase, 0.347f, 0.016f ) // S
			+ 0.27f * Peak( phase, 0.565f, 0.078f );// T
	}

	private static float Peak( float phase, float center, float width )
	{
		float x = (phase - center) / width;
		return MathF.Exp( -0.5f * x * x );
	}

	private string EcgSegmentStyle( int index )
	{
		float y0 = 24f - _ecgSamples[index] * 20f;
		float y1 = 24f - _ecgSamples[index + 1] * 20f;
		float dy = y1 - y0;
		float angle = MathF.Atan2( dy, EcgPointSpacing ) * 180f / MathF.PI;
		float length = MathF.Sqrt( EcgPointSpacing * EcgPointSpacing + dy * dy ) + 0.2f;
		return $"left: {CssNumber( index * EcgPointSpacing )}px; top: {CssNumber( y0 )}px; width: {CssNumber( length )}px; transform: rotate({CssNumber( angle )}deg);";
	}

	private static string CssNumber( float value ) =>
		value.ToString( "0.##", System.Globalization.CultureInfo.InvariantCulture );

	private static float Percent( float value, float maximum )
	{
		if ( maximum <= 0f )
			return 0f;

		return Math.Clamp( value / maximum * 100f, 0f, 100f );
	}

	private static int Whole( float value ) => (int)MathF.Ceiling( MathF.Max( 0f, value ) );

	private static string Phrase( string token )
	{
		return Language.GetPhrase( token, new Dictionary<string, object>() );
	}

	private static string Phrase( string token, string key, object value )
	{
		return Language.GetPhrase(
			token,
			new Dictionary<string, object> { [key] = value }
		);
	}

	private void SpectateNext()
	{
		LifeState?.SpectateNext();
		StateHasChanged();
	}

	private void ReturnToMenu()
	{
		LifeState?.ReturnToMenu();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		var health = Health;
		var armor = Armor;
		var stamina = Stamina;
		var weapon = LocalPlayer?
			.Components.Get<BaseInventoryComponent>()?
			.ActiveItem as BaseCombatWeapon;

		hash.Add( Player?.Id ?? Guid.Empty );
		hash.Add( IsLocalHud );
		hash.Add( health?.CurrentHealth ?? -1f );
		hash.Add( _ecgRevision );
		hash.Add( health?.StartingHardMaxHealth ?? -1f );
		hash.Add( health?.SoftMaxHealth ?? -1f );
		hash.Add( health?.HardMaxHealth ?? -1f );
		hash.Add( health?.IsDowned ?? false );
		hash.Add( health?.IsDead ?? false );
		hash.Add( health?.DownedReasonToken ?? string.Empty );
		hash.Add( health?.DownedInstigatorName ?? string.Empty );
		hash.Add( armor?.CurrentArmor ?? -1f );
		hash.Add( armor?.MaxArmor ?? -1f );
		hash.Add( stamina?.CurrentStamina ?? -1f );
		hash.Add( stamina?.MaxStamina ?? -1f );
		hash.Add( stamina?.IsExhausted ?? false );
		hash.Add( weapon?.Id ?? Guid.Empty );
		hash.Add( LifeState?.SpectatedPlayer?.Id ?? Guid.Empty );
		hash.Add( LifeState?.CanSpectate ?? false );
		return hash.ToHashCode();
	}
}
