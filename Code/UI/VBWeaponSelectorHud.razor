@using System
@using System.Linq
@using Sandbox
@using Sandbox.UI
@inherits Panel

@{
	var slotA = WeaponInSlot( VBWeaponSelectionController.FirstWeaponSlot );
	var slotB = WeaponInSlot( VBWeaponSelectionController.FirstWeaponSlot + 1 );
}

<root class="@RootClass">
	<div class="capacity-readout">
		<label>#vb.hud.weapon_capacity</label>
		<label class="capacity-value">@CurrentCarrySize / @MaximumCarrySize</label>
	</div>
	<div class="weapon-slots">
		@WeaponSlot( slotA, VBWeaponSelectionController.FirstWeaponSlot, "Slot1", "A" )
		@WeaponSlot( slotB, VBWeaponSelectionController.FirstWeaponSlot + 1, "Slot2", "B" )
	</div>
</root>

@code
{
	public GameObject Player { get; set; }

	public bool IsSuppressed { get; set; }

	private BaseInventoryComponent Inventory => Player?.Components.Get<BaseInventoryComponent>();
	private VBWeaponInventoryComponent WeaponInventory => Inventory as VBWeaponInventoryComponent;
	private VBWeaponSelectionController SelectionController => Player?.Components.Get<VBWeaponSelectionController>();
	private int CurrentCarrySize => WeaponInventory?.CurrentWeaponCarrySize ?? 0;
	private int MaximumCarrySize => WeaponInventory?.MaximumWeaponCarrySize ?? 5;

	private string RootClass => IsSuppressed
		|| Inventory is null
		|| !(SelectionController?.IsSelectionHudVisible ?? false)
			? "hidden"
			: string.Empty;

	private BaseCombatWeapon WeaponInSlot( int slot )
	{
		if ( SelectionController.IsValid() )
			return SelectionController.WeaponInSlot( slot );

		return Inventory?.Items
			.OfType<BaseCombatWeapon>()
			.Where( item => item.Slot == slot )
			.OrderBy( item => item.SlotOrder )
			.FirstOrDefault();
	}

	private RenderFragment WeaponSlot( BaseCombatWeapon weapon, int slot, string inputAction, string slotName ) => builder =>
	{
		var isPlaceholder = SelectionController?.IsSlotPlaceholder( slot ) ?? !weapon.IsValid();
		var isActive = SelectionController?.SelectedWeaponSlot == slot;
		var cssClass = $"weapon-slot {(isActive ? "active" : "inactive")} {(isPlaceholder ? "placeholder" : "occupied")}";
		var inputOrigin = Input.GetButtonOrigin( inputAction ) ?? inputAction.ToUpperInvariant();
		var weaponName = weapon.IsValid() ? Localize( weapon.DisplayName ) : Language.GetPhrase( "vb.hud.empty_slot" );
		var carrySize = VBWeaponInventoryComponent.GetCarrySize( weapon );

		builder.OpenElement( 0, "div" );
		builder.AddAttribute( 1, "class", cssClass );
		builder.OpenElement( 2, "label" );
		builder.AddAttribute( 3, "class", "slot-key" );
		builder.AddContent( 4, inputOrigin );
		builder.CloseElement();
		builder.OpenElement( 5, "div" );
		builder.AddAttribute( 6, "class", "slot-identity" );
		builder.OpenElement( 7, "label" );
		builder.AddAttribute( 8, "class", "slot-name" );
		builder.AddContent( 9, $"{Language.GetPhrase( "vb.hud.weapon_slot" )} {slotName}" );
		builder.CloseElement();
		builder.OpenElement( 10, "label" );
		builder.AddAttribute( 11, "class", "weapon-name" );
		builder.AddContent( 12, weaponName );
		builder.CloseElement();
		builder.CloseElement();
		builder.OpenElement( 13, "label" );
		builder.AddAttribute( 14, "class", "slot-weight" );
		builder.AddAttribute( 15, "title", Language.GetPhrase( "vb.hud.weapon_weight" ) );
		builder.AddContent( 16, carrySize );
		builder.CloseElement();
		builder.CloseElement();
	};

	private static string Localize( string value )
	{
		if ( string.IsNullOrWhiteSpace( value ) )
			return string.Empty;

		return value.Length > 1 && value[0] == '#'
			? Language.GetPhrase( value[1..] )
			: value;
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		var inventory = Inventory;

		hash.Add( Player?.Id ?? Guid.Empty );
		hash.Add( IsSuppressed );
		hash.Add( SelectionController?.IsSelectionHudVisible ?? false );
		hash.Add( SelectionController?.SelectedWeaponSlot ?? -1 );
		hash.Add( inventory?.ActiveItem?.Id ?? Guid.Empty );
		hash.Add( CurrentCarrySize );
		hash.Add( MaximumCarrySize );

		if ( inventory is not null )
		{
			foreach ( var weapon in inventory.Items.OfType<BaseCombatWeapon>() )
			{
				hash.Add( weapon.Id );
				hash.Add( weapon.Slot );
				hash.Add( weapon.SlotOrder );
				hash.Add( weapon.DisplayName );
			}
		}

		return hash.ToHashCode();
	}
}
