// Native, transparent reticle without the cloud glass_scope shader's framebuffer reads.
Layer0
{
	shader "shaders/complex.shader"
	F_TRANSLUCENT "1"
	F_SELF_ILLUM "1"
	F_DO_NOT_CAST_SHADOWS "1"
	F_RENDER_BACKFACES "1"
	g_flSelfIllumBrightness "1"
	TextureSelfIllumMask "materials/default/default_color.tga"
	// The official RGB reticle has zero alpha. Compile its red channel as opacity.
	TextureColor "materials/weapons/holographic_reticle.png"
	TextureTranslucency "materials/weapons/holographic_reticle.png"
}
