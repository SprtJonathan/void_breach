!Assets/weapons/p90/mesh/p90.vmdl_c
!*.shader_c
*.los
*.vpk
*launchSettings.json
*.sln
*.slnx

*idea

# Exported / standalone games
Exports/

# Local temporary build and inspection outputs
tmp/
